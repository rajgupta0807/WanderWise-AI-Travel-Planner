# Copy this file to ".env" for local development. Never commit ".env".

APP_ENV=development

# SQLite locally. On Render/Neon/Supabase use the PostgreSQL URL they give you.
DATABASE_URL=sqlite:///./travel_planner.db

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: any OpenAI-compatible API. Leave AI_API_KEY empty to use the
# built-in offline itinerary generator.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Comma-separated, or a JSON array. Use your frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
